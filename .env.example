# Dev port — distinct and uncommon per project (never 3000/3001/5173/5174/8000/8080/4200/5000).
PORT=7268
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ant_thing

# Moderation: /admin asks for this. Unset = nobody is admin. Set it in Drydock → Project → Environment.
ADMIN_TOKEN=
# Set to 1 to stop new puzzles being published (the gallery and runs keep working).
PUBLISH_OFF=
